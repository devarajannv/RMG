  changes    Json?
  metadata   Json?
  timestamp  DateTime    @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, timestamp])
  @@index([tenantId, action])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  RENEW
  ACTIVATE
  TERMINATE
  LINK_CONTRACT
  UNLINK_CONTRACT
  APPROVE
  REJECT
  SUBMIT
}

// =============================================================================
// CURRENCY & EXCHANGE RATES
// =============================================================================
model Currency {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  code          String   @db.VarChar(3) // ISO 4217: USD, INR, EUR
  name          String   @db.VarChar(100)
  symbol        String   @db.VarChar(10)
  isBase        Boolean  @default(false) // Organization's base currency
  isActive      Boolean  @default(true)
  decimalPlaces Int      @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")

  @@unique([tenantId, code])
  @@index([tenantId, isBase])
  @@index([tenantId, isActive])
}

model ExchangeRate {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  fromCurrencyId String    @db.Uuid
  fromCurrency   Currency  @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrencyId   String    @db.Uuid
  toCurrency     Currency  @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  rate           Decimal   @db.Decimal(18, 8) // High precision for currency conversion
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  source         String    @default("MANUAL") @db.VarChar(50) // MANUAL, API, IMPORT
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, fromCurrencyId, toCurrencyId, effectiveFrom])
  @@index([tenantId, effectiveFrom])
  @@index([tenantId, fromCurrencyId, toCurrencyId])
}

// =============================================================================
// ENHANCED ROLE MANAGEMENT
// =============================================================================
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  module      String   @db.VarChar(50) // resources, projects, contracts, etc.
  action      String   @db.VarChar(50) // create, read, update, delete, approve, export
  scope       String   @default("ALL") @db.VarChar(50) // ALL, OWN, TEAM, PRACTICE
  description String?  @db.VarChar(200)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@unique([tenantId, module, action, scope])
  @@index([tenantId, module])
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  conditions   Json? // Additional conditions for fine-grained access
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model RoleAssignmentAudit {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  action     String   @db.VarChar(20) // ASSIGNED, REVOKED
  assignedBy String   @db.Uuid
  reason     String?  @db.VarChar(500)
  timestamp  DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, timestamp])
}

// =============================================================================
// DOCUMENT MANAGEMENT
// =============================================================================
model Document {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Identity
  name        String  @db.VarChar(255)
  description String?
  mimeType    String  @db.VarChar(100)
  fileSize    Int // Size in bytes

  // Classification
  classification DocumentClassification @default(INTERNAL)
  category       String?                @db.VarChar(100) // MSA, SOW, CR, INVOICE, TIMESHEET, etc.
  tags           String[]

  // Storage
  storageProvider String  @default("LOCAL") @db.VarChar(50) // LOCAL, S3, AZURE
  storagePath     String  @db.VarChar(500)
  checksum        String? @db.VarChar(64) // SHA-256 hash for integrity

  // Relationships
  entityType String? @db.VarChar(50) // contract, project, resource, etc.
  entityId   String? @db.Uuid

  // E-Signature
  signatureStatus   SignatureStatus?
  signatureProvider String?          @db.VarChar(50) // DOCUSIGN, ADOBE_SIGN
  signatureRef      String?          @db.VarChar(200) // External signature ID

  // Current version tracking
  currentVersionId String? @db.Uuid
  versionCount     Int     @default(1)

  // Ownership
  uploadedById String @db.Uuid

  // Status
  status    DocumentStatus @default(ACTIVE)
  expiresAt DateTime?

  // Metadata
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  versions    DocumentVersion[]
  accessRules DocumentAccess[]
  accessLogs  DocumentAccessLog[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, classification])
  @@index([tenantId, category])
  @@index([tenantId, status])
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum SignatureStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @db.Uuid
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int

  // Storage
  storagePath String  @db.VarChar(500)
  fileSize    Int
  checksum    String? @db.VarChar(64)

  // Metadata
  changeNotes String?  @db.VarChar(500)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentAccess {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Access target (one of these should be set)
  roleId     String? @db.Uuid
  userId     String? @db.Uuid
  practiceId String? @db.Uuid

  // Permissions
  canView     Boolean @default(true)
  canDownload Boolean @default(false)
  canEdit     Boolean @default(false)
  canDelete   Boolean @default(false)
  canShare    Boolean @default(false)

  // Time-bound access
  expiresAt DateTime?

  // Audit
  grantedById String    @db.Uuid
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([documentId])
  @@index([roleId])
  @@index([userId])
}

model DocumentAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  action     String   @db.VarChar(50) // VIEW, DOWNLOAD, EDIT, DELETE, SHARE
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  timestamp  DateTime @default(now())

  @@index([documentId, timestamp])
  @@index([userId, timestamp])
}

// =============================================================================
// AI AGENT CONVERSATIONS
// =============================================================================
model AgentConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  title     String?  @db.VarChar(200)
  context   Json? // Current context (page, selected entity, etc.)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages AgentMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, updatedAt])
}

model AgentMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String            @db.VarChar(20) // user, assistant, system
  content        String

  // AI Metadata
  model       String?  @db.VarChar(50) // gemini-flash, gpt-4o-mini, etc.
  tokens      Json? // { input: X, output: Y }
  confidence  Decimal? @db.Decimal(3, 2)
  routingTier String?  @db.VarChar(20) // T1, T2, T3, T4

  // Response rendering
  responseType String? @db.VarChar(50) // text, table, chart, cards
  responseData Json? // Structured data for rich rendering

  // Feedback
  feedback     String? @db.VarChar(20) // positive, negative
  feedbackNote String? @db.VarChar(500)

  timestamp DateTime @default(now())

  @@index([conversationId, timestamp])
}

// =============================================================================
// AI MIGRATION TOOL
// =============================================================================
model ImportJob {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  // Job Identity
  name        String  @db.VarChar(200)
  description String?

  // Source File
  sourceFileName String @db.VarChar(255)
  sourceFileType String @db.VarChar(50) // CSV, XLSX, JSON, PDF, IMAGE
  sourceFileSize Int
  sourceFilePath String @db.VarChar(500)

  // Import Configuration
  importPurpose   ImportPurpose   @default(MIGRATION)
  duplicateAction DuplicateAction @default(SKIP)

  // AI Analysis
  detectedEntities   Json? // { resources: 500, allocations: 200, ... }
  fieldMappings      Json? // AI-suggested mappings
  dependencyOrder    Json? // Order to import entities
  referencesToCreate Json? // Missing references to auto-create

  // Autonomy Level (earned over time)
  autonomyLevel     Int     @default(1) // 1=confirm all, 2=auto high-confidence, 3=full auto
  sourceFingerprint String? @db.VarChar(64) // Hash to identify same source format

  // Processing Status
  status            ImportJobStatus @default(PENDING_ANALYSIS)
  analysisStarted   DateTime?
  analysisCompleted DateTime?
  importStarted     DateTime?
  importCompleted   DateTime?

  // Results
  totalRecords    Int @default(0)
  importedRecords Int @default(0)
  skippedRecords  Int @default(0)
  errorRecords    Int @default(0)

  // Auto-created references
  autoCreatedRefs Json? // { practices: ['AI & ML'], locations: ['Coimbatore'] }

  // Rollback
  canRollback     Boolean   @default(true)
  rollbackExpires DateTime?
  rolledBackAt    DateTime?
  rolledBackBy    String?   @db.Uuid

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  records  ImportJobRecord[]
  mappings ImportMapping[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, sourceFingerprint])
}

enum ImportPurpose {
  MIGRATION // First-time bulk load - skip duplicates
  SYNC // Refresh from HR system - update duplicates
  MANUAL // Ad-hoc upload - flag duplicates
}

enum DuplicateAction {
  SKIP // Keep existing, ignore incoming
  UPDATE // Overwrite existing with incoming
  FLAG // Mark for user review
}

enum ImportJobStatus {
  PENDING_ANALYSIS // File uploaded, waiting for AI analysis
  ANALYZING // AI analyzing file
  PENDING_APPROVAL // Waiting for user to approve mappings/refs
  APPROVED // User approved, ready to import
  IMPORTING // Import in progress
  COMPLETED // Import finished
  COMPLETED_WITH_ERRORS // Import finished with some errors
  FAILED // Import failed
  ROLLED_BACK // Import was rolled back
}

model ImportMapping {
  id          String    @id @default(uuid()) @db.Uuid
  importJobId String    @db.Uuid
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  // Source Column
  sourceColumn       String @db.VarChar(100)
  sourceSampleValues Json? // First few values for preview

  // Target Field
  targetEntity String @db.VarChar(50) // resource, project, allocation, etc.
  targetField  String @db.VarChar(100)

  // AI Confidence
  confidence  Decimal @db.Decimal(3, 2) // 0.00 to 1.00
  aiReasoning String? @db.VarChar(500) // Why AI made this mapping

  // User Override
  userApproved   Boolean @default(false)
  userOverridden Boolean @default(false)

  // Transformation
  transformationType   String? @db.VarChar(50) // DATE_PARSE, LOOKUP, UPPERCASE, etc.
  transformationConfig Json? // Config for transformation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([importJobId, sourceColumn])
  @@index([importJobId])
}

model ImportJobRecord {
  id          String    @id @default(uuid()) @db.Uuid
  importJobId String    @db.Uuid
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  // Source Data
  rowNumber  Int
  sourceData Json // Original row data

  // Target
  targetEntity String  @db.VarChar(50)
  targetId     String? @db.Uuid // ID of created/updated record

  // Processing
  status     ImportRecordStatus @default(PENDING)
  confidence Decimal?           @db.Decimal(3, 2)

  // Errors/Warnings
  errors   Json? // Array of error messages
  warnings Json? // Array of warning messages

  // For rollback
  previousData Json? // Data before update (for rollback)
  wasCreated   Boolean @default(false) // true if new record, false if update

  createdAt DateTime @default(now())

  @@index([importJobId, status])
  @@index([importJobId, targetEntity])
}

enum ImportRecordStatus {
  PENDING // Waiting to be processed
  PROCESSING // Currently being processed
  IMPORTED // Successfully imported
  UPDATED // Successfully updated existing
  SKIPPED // Skipped (duplicate, etc.)
  ERROR // Failed with error
  FLAGGED // Flagged for user review
}

// =============================================================================
// REQUEST FLOW SYSTEM - Enterprise Workflow Management
// =============================================================================

// Request Type Definition (System-level, tenant can override via config)
model RequestType {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @db.VarChar(50) // RESOURCE_ALLOCATION, etc. - unique per tenant or system
  name            String          @db.VarChar(100)
  description     String?         @db.VarChar(500)
  category        RequestCategory
  defaultPriority Priority        @default(MEDIUM)

  // Tenant Ownership (null = system type, set = tenant-created)
  tenantId     String? @db.Uuid
  tenant       Tenant? @relation("TenantRequestTypes", fields: [tenantId], references: [id])
  
  // Cloning/Versioning (track which system type this was cloned from)
  clonedFromId String?      @db.Uuid
  clonedFrom   RequestType? @relation("RequestTypeClones", fields: [clonedFromId], references: [id])
  clones       RequestType[] @relation("RequestTypeClones")

  // SLA Configuration (defaults, can be overridden per tenant)
  responseSlaHours   Int                @default(24)
  resolutionSlaHours Int                @default(72)
  slaCalculationType SlaCalculationType @default(BUSINESS_HOURS)

  // Behavior
  isActive            Boolean @default(true)
  isSystemType        Boolean @default(true) // false = tenant-created
  requiresApproval    Boolean @default(true)
  allowDraft          Boolean @default(true)
  allowAttachments    Boolean @default(true)
  maxAttachmentSizeMb Int     @default(10)
  maxAttachments      Int     @default(5)

  // Form Configuration
  formSchema        Json? // JSON Schema for dynamic form
  formSchemaVersion Int      @default(1)
  requiredFields    String[] // List of required field paths
  sensitiveFields   String[] // Fields to mask/restrict

  // Execution Handlers (service method names)
  onApprovalHandler     String? @db.VarChar(100)
  onRejectionHandler    String? @db.VarChar(100)
  onCancellationHandler String? @db.VarChar(100)

  // Rollback Configuration
  allowRollback            Boolean            @default(true)
  rollbackWindowDays       Int                @default(30)
  rollbackRequiresApproval Boolean            @default(true)
  rollbackPermission       RollbackPermission @default(ADMIN_ONLY)

  // Visibility
  visibilityScope RequestVisibility @default(TENANT)

  // Retention
  retentionDays Int @default(2555) // ~7 years

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  requests          Request[]
  approvalRules     ApprovalRule[]
  tenantConfigs     TenantRequestTypeConfig[]
  templates         RequestTemplate[]
  slaPriorityMatrix SlaPriorityMatrix[]

  @@unique([code, tenantId]) // Code unique per tenant (null tenantId = system)
  @@index([category])
  @@index([isActive])
  @@index([tenantId])
  @@index([isSystemType])
}

// Tenant-specific overrides for system request types
model TenantRequestTypeConfig {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  requestTypeId String      @db.Uuid
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])

  // Overrides (null = use system default)
  responseSlaHours   Int?
  resolutionSlaHours Int?
  defaultPriority    Priority?
  isEnabled          Boolean   @default(true)

  // Tenant-specific approval chain
  approvalChainId String?        @db.Uuid
  approvalChain   ApprovalChain? @relation(fields: [approvalChainId], references: [id])

  // Field Schema & Validation (NEW)
  requiredFields   String[] // Field names required for this request type
  fieldValidations Json?    // JSON schema for field validation rules

  // Auto-assignment (NEW)
  autoAssignToRequester Boolean @default(false) // Auto-assign to requester if no chain
  requiresApproval      Boolean @default(true)  // If false, auto-approve on submit

  // Post-Workflow Actions (NEW)
  onApprovalActions  Json? // [{"type": "CREATE_DOCUMENT", "template": "..."}]
  onRejectionActions Json? // [{"type": "NOTIFY_WEBHOOK", "url": "..."}]

  // Escalation Policy (NEW)
  escalationPolicy Json? // {"afterHours": 24, "escalateTo": "PRACTICE_HEAD"}

  // Relations
  triggers RequestTrigger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, requestTypeId])
  @@index([tenantId])
}

// Request Type Template - Pre-built bundles for quick setup
model RequestTypeTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  category    String  @db.VarChar(50) // "HR", "Finance", "Operations", "General"
  
  // Template content (stored as JSON)
  requestTypes Json   // Array of request type definitions
  workflows    Json   // Array of workflow definitions
  bindings     Json   // Default type→workflow mappings
  
  // Metadata
  version    Int     @default(1)
  isActive   Boolean @default(true)
  usageCount Int     @default(0)
  tags       String[] // Tags for filtering/search
  
  // Optional: Icon and preview image
  iconName     String? @db.VarChar(50)  // Lucide icon name
  previewImage String? @db.VarChar(500) // URL to preview image
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([category])
  @@index([isActive])
}

// Approval Chain Definition
model ApprovalChain {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Identity
  name        String  @db.VarChar(100)
  code        String  @db.VarChar(50)
  description String? @db.VarChar(500)

  // Versioning
  version       Int                 @default(1)
  status        ApprovalChainStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?             @db.Uuid

  // Scope (optional filtering)
  practiceId String?            @db.Uuid
  practice   Practice?          @relation(fields: [practiceId], references: [id])
  scope      ApprovalChainScope @default(TENANT)

  // Effective Period
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  // Versioning chain
  clonedFromId   String?         @db.Uuid
  clonedFrom     ApprovalChain?  @relation("ChainVersion", fields: [clonedFromId], references: [id])
  clonedVersions ApprovalChain[] @relation("ChainVersion")

  // Audit
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  steps         ApprovalStep[]
  tenantConfigs TenantRequestTypeConfig[]
  requests      Request[]
  triggers      RequestTrigger[]  // Triggers that override to use this chain

  @@unique([tenantId, code, version])
  @@index([tenantId, status])
  @@index([tenantId, practiceId])
}

// Approval Step within a Chain
model ApprovalStep {
  id      String        @id @default(uuid()) @db.Uuid
  chainId String        @db.Uuid
  chain   ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  // Order & Identity
  stepOrder    Int
  name         String  @db.VarChar(100)
  instructions String? @db.VarChar(1000)

  // Primary Approver
  approverType   ApproverType
  approverRoleId String?      @db.Uuid
  approverRole   Role?        @relation("StepApproverRole", fields: [approverRoleId], references: [id])
  approverUserId String?      @db.Uuid
  approverUser   User?        @relation("StepApprover", fields: [approverUserId], references: [id])

  // Function-based approval (NEW - preferred for dynamic resolution)
  approvalFunctionId String?           @db.Uuid
  approvalFunction   ApprovalFunction? @relation("StepApprovalFunction", fields: [approvalFunctionId], references: [id])

  // Dynamic Approver Resolution
  practiceSource     PracticeSource? // For PRACTICE_HEAD - whose practice?
  roleAssignmentMode RoleAssignmentMode @default(ANY)

  // Fallback when primary can't be resolved
  fallbackType       ApproverType?
  fallbackRoleId     String?       @db.Uuid
  fallbackUserId     String?       @db.Uuid
  skipIfUnresolvable Boolean       @default(false)

  // Approval Behavior
  approvalMode ApprovalMode       @default(ANY)
  onConflict   ConflictResolution @default(REJECTION_WINS)
  isOptional   Boolean            @default(false)
  canDelegate  Boolean            @default(true)

  // Skip Conditions (JSONLogic format)
  skipCondition Json?

  // Auto-approval (use with caution)
  autoApproveAfterHours Int?
  autoApproveCondition  Json?

  // Per-step SLA
  slaHours Int?

  // Escalation
  escalateAfterHours Int?
  escalateToType     ApproverType?
  escalateToRoleId   String?       @db.Uuid
  escalateToUserId   String?       @db.Uuid

  // Reminders
  reminderAfterHours    Int @default(24)
  reminderIntervalHours Int @default(24)
  maxReminders          Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  approvals RequestApproval[]

  @@unique([chainId, stepOrder])
  @@index([chainId])
}

// Conditional Approval Routing Rules
model ApprovalRule {
  id            String      @id @default(uuid()) @db.Uuid
  requestTypeId String      @db.Uuid
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  // Condition
  name              String            @db.VarChar(100)
  conditionField    String            @db.VarChar(100) // requestData.amount, resource.band
  conditionOperator ConditionOperator
  conditionValue    String            @db.VarChar(500)

  // Action
  actionType             RuleActionType
  addChainId             String?        @db.Uuid
  addStepAfter           Int?
  skipStepOrder          Int?
  overridePriority       Priority?
  overrideApproverUserId String?        @db.Uuid

  // Priority (higher = evaluated first)
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestTypeId, isActive])
  @@index([tenantId])
}

// Main Request Model
model Request {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Identity
  requestNumber String      @db.VarChar(50)
  typeId        String      @db.Uuid
  type          RequestType @relation(fields: [typeId], references: [id])

  // Content
  title       String  @db.VarChar(200)
  description String?
  requestData Json // Validated against RequestType.formSchema
  locale      String  @default("en") @db.VarChar(10)

  // Requester
  requesterId  String  @db.Uuid
  requester    User    @relation("RequestRequester", fields: [requesterId], references: [id])
  onBehalfOfId String? @db.Uuid
  onBehalfOf   User?   @relation("RequestOnBehalf", fields: [onBehalfOfId], references: [id])

  // Priority & Urgency
  priority                Priority  @default(MEDIUM)
  urgencyJustification    String?   @db.VarChar(500)
  requestedCompletionDate DateTime? @db.Date

  // Status & Workflow
  status               RequestStatus  @default(DRAFT)
  approvalChainId      String?        @db.Uuid
  approvalChain        ApprovalChain? @relation(fields: [approvalChainId], references: [id])
  approvalChainVersion Int?
  currentStepOrder     Int            @default(0)

  // SLA Tracking
  submittedAt           DateTime?
  responseDueAt         DateTime?
  resolutionDueAt       DateTime?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  responseSlaBreached   Boolean   @default(false)
  resolutionSlaBreached Boolean   @default(false)
  escalatedAt           DateTime?
  escalationLevel       Int       @default(0)

  // SLA Pause/Resume
  slaPausedAt          DateTime?
  slaPauseDurationMins Int       @default(0)

  // Related Entities (primary - for quick queries)
  resourceId   String?     @db.Uuid
  resource     Resource?   @relation(fields: [resourceId], references: [id])
  projectId    String?     @db.Uuid
  project      Project?    @relation(fields: [projectId], references: [id])
  allocationId String?     @db.Uuid
  allocation   Allocation? @relation(fields: [allocationId], references: [id])
  contractId   String?     @db.Uuid
  contract     Contract?   @relation(fields: [contractId], references: [id])

  // External References
  externalRef String? @db.VarChar(200)
  externalUrl String? @db.VarChar(500)

  // Dependencies
  dependsOnId       String?   @db.Uuid
  dependsOn         Request?  @relation("RequestDependency", fields: [dependsOnId], references: [id])
  dependentRequests Request[] @relation("RequestDependency")
  blockedReason     String?   @db.VarChar(200)

  // Rollback Support
  isReversal        Boolean         @default(false)
  originalRequestId String?         @db.Uuid
  originalRequest   Request?        @relation("RequestReversal", fields: [originalRequestId], references: [id])
  reversalRequests  Request[]       @relation("RequestReversal")
  rollbackData      Json? // Snapshot of state before execution
  canRollback       Boolean         @default(true)
  rollbackDeadline  DateTime?
  rollbackStatus    RollbackStatus?
  reversedAt        DateTime?
  reversedById      String?         @db.Uuid

  // Execution Result
  resultEntityType String? @db.VarChar(50)
  resultEntityId   String? @db.Uuid
  executionNotes   String?

  // Optimistic Locking
  version Int @default(0)

  // Relations
  approvals         RequestApproval[]
  comments          RequestComment[]
  history           RequestHistory[]
  attachments       RequestAttachment[]
  watchers          RequestWatcher[]
  affectedResources RequestAffectedResource[]
  rollbackSteps     RollbackStep[]
  slaBreachEvents   SlaBreachEvent[]
  notifications     Notification[]
  lock              RequestLock?
  triggerExecutions TriggerExecution[]  // If created by a trigger

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, requestNumber])
  @@index([tenantId, status])
  @@index([tenantId, requesterId])
  @@index([tenantId, typeId])
  @@index([tenantId, priority])
  @@index([tenantId, submittedAt])
  @@index([tenantId, responseSlaBreached])
  @@index([tenantId, resolutionSlaBreached])
  @@index([tenantId, resourceId])
  @@index([tenantId, projectId])
  @@index([tenantId, createdAt])
}

// Request Approval Record
model RequestApproval {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Step Reference
  stepId    String       @db.Uuid
  step      ApprovalStep @relation(fields: [stepId], references: [id])
  stepOrder Int
  stepName  String       @db.VarChar(100)

  // Assigned Approver
  approverId       String       @db.Uuid
  approver         User         @relation("ApprovalApprover", fields: [approverId], references: [id])
  assignedVia      ApproverType
  assignmentReason String?      @db.VarChar(200)

  // Delegation
  delegatedFromId String? @db.Uuid
  delegatedFrom   User?   @relation("DelegatedApproval", fields: [delegatedFromId], references: [id])
  delegationId    String? @db.Uuid

  // Reassignment (admin override)
  reassignedFromId   String?   @db.Uuid
  reassignedFrom     User?     @relation("ReassignedApproval", fields: [reassignedFromId], references: [id])
  reassignedById     String?   @db.Uuid
  reassignedAt       DateTime?
  reassignmentReason String?   @db.VarChar(500)

  // Status & Decision
  status   ApprovalActionStatus @default(PENDING)
  decision ApprovalDecision?
  comments String?

  // Timeline
  dueAt     DateTime?
  viewedAt  DateTime?
  decidedAt DateTime?

  // Reminders
  lastReminderAt DateTime?
  reminderCount  Int       @default(0)

  // Escalation
  escalatedAt   DateTime?
  escalatedToId String?   @db.Uuid

  // Audit
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  // Optimistic Locking
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, stepId, approverId])
  @@index([requestId, stepOrder])
  @@index([approverId, status])
  @@index([dueAt, status])
  @@index([status])
}

// Request Comments with Threading
model RequestComment {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation("RequestCommentUser", fields: [userId], references: [id])

  // Threading
  parentId String?          @db.Uuid
  parent   RequestComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies  RequestComment[] @relation("CommentThread")

  // Content
  content    String
  isInternal Boolean @default(false) // Only visible to approvers

  // Edit tracking
  isEdited Boolean   @default(false)
  editedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([requestId, createdAt])
  @@index([parentId])
}

// Request History/Audit Log
model RequestHistory {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation("RequestHistoryUser", fields: [userId], references: [id])

  // Action
  action     RequestAction
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  details    Json?

  // Rollback info
  rollbackReason   String? @db.VarChar(500)
  affectedEntities Json?

  // Audit
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([userId])
  @@index([action])
}

// Request Attachments with Virus Scanning
model RequestAttachment {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // File Info
  fileName String  @db.VarChar(255)
  fileSize Int
  mimeType String  @db.VarChar(100)
  filePath String  @db.VarChar(500)
  checksum String? @db.VarChar(64)

  // Virus Scanning
  scanStatus AttachmentScanStatus @default(PENDING)
  scannedAt  DateTime?
  scanResult String?              @db.VarChar(200)

  // Upload Info
  uploadedById String @db.Uuid
  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([requestId])
  @@index([scanStatus])
}

// Request Watchers (CC)
model RequestWatcher {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation("RequestWatcher", fields: [userId], references: [id])
  addedById String  @db.Uuid
  addedBy   User    @relation("WatcherAddedBy", fields: [addedById], references: [id])

  // Notification preferences for this watch
  notifyOnStatusChange Boolean @default(true)
  notifyOnComment      Boolean @default(true)
  notifyOnApproval     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, userId])
  @@index([userId])
}

// For bulk requests affecting multiple resources
model RequestAffectedResource {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @db.Uuid
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id])
  role       String?  @db.VarChar(100)

  @@unique([requestId, resourceId])
  @@index([requestId])
  @@index([resourceId])
}

// Request sequence for number generation
model RequestSequence {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  year       Int
  lastNumber Int    @default(0)

  @@unique([tenantId, year])
}

// Request Lock for concurrent edit prevention
model RequestLock {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @unique @db.Uuid
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lockedById String   @db.Uuid
  lockedBy   User     @relation("RequestLocker", fields: [lockedById], references: [id])
  lockedAt   DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

// Rollback Step Tracking
model RollbackStep {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder  Int
  entityType String            @db.VarChar(50)
  entityId   String            @db.Uuid
  operation  RollbackOperation

  // State snapshots
  beforeState Json
  afterState  Json

  // Execution tracking
  status       RollbackStepStatus @default(PENDING)
  executedAt   DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([requestId, stepOrder])
}

// Delegation Management
model Delegation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Parties
  delegatorId String @db.Uuid
  delegator   User   @relation("Delegator", fields: [delegatorId], references: [id])
  delegateId  String @db.Uuid
  delegate    User   @relation("Delegate", fields: [delegateId], references: [id])

  // Scope
  requestTypeIds String[] @db.Uuid
  practiceIds    String[] @db.Uuid
  maxAmount      Decimal? @db.Decimal(15, 2)

  // Period
  startDate DateTime @db.Timestamptz
  endDate   DateTime @db.Timestamptz
  reason    String?  @db.VarChar(500)

  // Approval
  requiresApproval Boolean                  @default(false)
  approvalStatus   DelegationApprovalStatus @default(APPROVED)
  approvedById     String?                  @db.Uuid
  approvedAt       DateTime?

  // Revocation
  revokedAt        DateTime?
  revokedById      String?   @db.Uuid
  revocationReason String?   @db.VarChar(500)

  // Usage tracking
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  // Audit
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, delegatorId])
  @@index([tenantId, delegateId])
  @@index([tenantId, startDate, endDate])
}

// SLA Breach Events
model SlaBreachEvent {
  id        String  @id @default(uuid()) @db.Uuid
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  breachType SlaBreachType
  breachedAt DateTime      @default(now())
  dueAt      DateTime
  actualAt   DateTime?

  // Escalation tracking
  escalationLevel Int       @default(1)
  escalatedToId   String?   @db.Uuid
  escalatedTo     User?     @relation("SlaEscalatedTo", fields: [escalatedToId], references: [id])
  escalatedAt     DateTime?

  // Resolution
  resolvedAt      DateTime?
  resolutionNotes String?   @db.VarChar(500)

  @@index([requestId])
  @@index([breachedAt])
  @@index([breachType])
}

// SLA Priority Matrix (per tenant per type)
model SlaPriorityMatrix {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  requestTypeId String?      @db.Uuid
  requestType   RequestType? @relation(fields: [requestTypeId], references: [id])

  priority           Priority
  responseSlaHours   Int
  resolutionSlaHours Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, requestTypeId, priority])
}

// Business Hours Configuration
model BusinessHoursConfig {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  timezone    String @default("Asia/Kolkata") @db.VarChar(50)
  startHour   Int    @default(9)
  startMinute Int    @default(0)
  endHour     Int    @default(18)
  endMinute   Int    @default(0)
  workDays    Int[]  @default([1, 2, 3, 4, 5]) // 0=Sun, 1=Mon, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Holiday Calendar
model Holiday {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  date        DateTime    @db.Date
  name        String      @db.VarChar(100)
  type        HolidayType @default(COMPANY)
  isOptional  Boolean     @default(false)
  locationIds String[]    @db.Uuid

  // Recurring support
  isRecurring    Boolean @default(false)
  recurringMonth Int?
  recurringDay   Int?

  createdAt DateTime @default(now())

  @@unique([tenantId, date, name])
  @@index([tenantId, date])
}

// Request Templates
model RequestTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  requestTypeId String      @db.Uuid
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])

  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(500)
  defaultData     Json
  defaultPriority Priority?

  isPublic    Boolean  @default(true)
  practiceIds String[] @db.Uuid

  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, requestTypeId])
  @@index([tenantId, isPublic])
}

// In-App Notifications
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid
  user     User   @relation("UserNotifications", fields: [userId], references: [id])

  // Content
  type    NotificationType
  title   String           @db.VarChar(200)
  message String

  // Reference
  requestId  String?  @db.Uuid
  request    Request? @relation(fields: [requestId], references: [id])
  entityType String?  @db.VarChar(50)
  entityId   String?  @db.Uuid
  actionUrl  String?  @db.VarChar(500)

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Delivery
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId, isRead])
  @@index([tenantId, createdAt])
  @@index([userId, type])
}

// User Notification Preferences
model NotificationPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("NotificationPreferences", fields: [userId], references: [id])

  eventType NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventType, channel])
}

// =============================================================================
// REQUEST TRIGGERS (Event → Request Pipeline)
// =============================================================================

// RequestTrigger: Defines how external events create requests
model RequestTrigger {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Identity
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  // Trigger Source
  sourceType TriggerSourceType
  webhookId  String?           @db.Uuid // Link to inbound webhook config
  webhook    InboundWebhook?   @relation(fields: [webhookId], references: [id])

  // Event Filtering
  eventType   String  @db.VarChar(100) // e.g., "deal.closed", "invoice.paid"
  eventFilter Json?   // JSON conditions: {"properties.stage": "won", "properties.amount": {"$gte": 50000}}

  // Target Request Configuration
  requestTypeConfigId String                  @db.Uuid
  requestTypeConfig   TenantRequestTypeConfig @relation(fields: [requestTypeConfigId], references: [id])

  // Field Mapping (external payload → request fields)
  fieldMapping Json // {"title": "$.deal.name", "metadata.dealValue": "$.deal.amount"}

  // Default Values
  defaultPriority Priority @default(MEDIUM)
  defaultMetadata Json?    // Static metadata to merge

  // Optional Workflow Override
  approvalChainId String?        @db.Uuid
  approvalChain   ApprovalChain? @relation(fields: [approvalChainId], references: [id])

  // Execution Control
  isActive           Boolean @default(true)
  requireConfirmation Boolean @default(false) // If true, creates draft for review
  deduplicationKey   String? @db.VarChar(200) // JSONPath to use for dedup, e.g., "$.deal.id"
  deduplicationHours Int?    // Window for deduplication

  // Audit
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  executions TriggerExecution[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, sourceType, eventType])
}

// Inbound Webhook Configuration (for receiving external events)
model InboundWebhook {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Identity
  name        String               @db.VarChar(100)
  source      InboundWebhookSource // HUBSPOT, SALESFORCE, STRIPE, CUSTOM
  description String?              @db.VarChar(500)

  // Security
  secretKey       String  @db.VarChar(200) // For signature validation
  signatureHeader String? @db.VarChar(100) // Header containing signature
  signatureAlgo   String? @db.VarChar(50)  // hmac-sha256, etc.

  // Endpoint
  endpointPath String @unique @db.VarChar(100) // /webhooks/inbound/{endpointPath}

  // Status
  isActive            Boolean   @default(true)
  lastReceivedAt      DateTime?
  totalEventsReceived Int       @default(0)

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  triggers RequestTrigger[]
  events   InboundWebhookEvent[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([endpointPath])
}

// Inbound Webhook Event Log
model InboundWebhookEvent {
  id        String         @id @default(uuid()) @db.Uuid
  webhookId String         @db.Uuid
  webhook   InboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  // Event Data
  eventType String @db.VarChar(100)
  payload   Json
  headers   Json?

  // Processing
  status     TriggerEventStatus @default(PENDING)
  processedAt DateTime?
  errorMessage String?           @db.VarChar(1000)

  // Signature Validation
  signatureValid Boolean?

  createdAt DateTime @default(now())

  // Relations
  executions TriggerExecution[]

  @@index([webhookId, createdAt])
  @@index([status])
}

// Trigger Execution Log (audit trail)
model TriggerExecution {
  id        String         @id @default(uuid()) @db.Uuid
  triggerId String         @db.Uuid
  trigger   RequestTrigger @relation(fields: [triggerId], references: [id])

  // Source Event (if from webhook)
  webhookEventId String?              @db.Uuid
  webhookEvent   InboundWebhookEvent? @relation(fields: [webhookEventId], references: [id])

  // Input
  inputPayload Json
  matchedFilter Boolean @default(true)

  // Output
  status    TriggerExecutionStatus
  requestId String?                @db.Uuid // Created request ID if successful
  request   Request?               @relation(fields: [requestId], references: [id])

  // Details
  mappedFields Json?                 // Result of field mapping
  errorMessage String? @db.VarChar(1000)
  skippedReason String? @db.VarChar(500) // Why trigger was skipped (dedup, filter, etc.)

  // Timing
  executedAt DateTime @default(now())
  durationMs Int?

  @@index([triggerId, executedAt])
  @@index([requestId])
}

// Enums for Request Triggers
enum TriggerSourceType {
  WEBHOOK     // External webhook (HubSpot, Salesforce, etc.)
  MANUAL      // User-initiated from UI
  SCHEDULED   // Cron/scheduled job
  API         // Direct API call
  INTERNAL    // Internal system event
}

enum InboundWebhookSource {
  HUBSPOT
  SALESFORCE
  STRIPE
  JIRA
  SLACK
  TEAMS
  CUSTOM
}

enum TriggerEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

enum TriggerExecutionStatus {
  SUCCESS           // Request created
  SKIPPED_FILTER    // Event didn't match filter
  SKIPPED_DUPLICATE // Deduplication prevented
  SKIPPED_INACTIVE  // Trigger was inactive
  FAILED_MAPPING    // Field mapping failed
  FAILED_VALIDATION // Request validation failed
  FAILED_ERROR      // Unexpected error
}

// Webhooks for External Integrations (Outbound)
model Webhook {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name   String @db.VarChar(100)
  url    String @db.VarChar(500)
  secret String @db.VarChar(200)

  events   WebhookEvent[]
  isActive Boolean        @default(true)

  // Retry config
  maxRetries        Int @default(3)
  retryDelaySeconds Int @default(60)

  // Health
  lastTriggeredAt     DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int       @default(0)

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  logs WebhookLog[]

  @@index([tenantId, isActive])
}

// Webhook Delivery Logs
model WebhookLog {
  id        String  @id @default(uuid()) @db.Uuid
  webhookId String  @db.Uuid
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event   WebhookEvent
  payload Json

  // Delivery
  statusCode  Int?
  response    String?
  deliveredAt DateTime?

  // Retries
  attempt     Int       @default(1)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
}

// Archived Requests (for retention)
model ArchivedRequest {
  id             String   @id @db.Uuid
  tenantId       String   @db.Uuid
  originalData   Json
  archivedAt     DateTime @default(now())
  archivedReason String   @db.VarChar(100)

  @@index([tenantId])
  @@index([archivedAt])
}

