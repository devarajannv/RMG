// RMGaaS Prisma Schema
// Resource Management & Governance as a Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// TENANT (Organization)
// =============================================================================
model Tenant {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  slug            String    @unique @db.VarChar(100)
  tier            TenantTier @default(FREE)
  status          TenantStatus @default(TRIAL)
  settings        Json?
  logoUrl         String?   @db.VarChar(500)
  primaryColor    String?   @db.VarChar(7)
  timezone        String    @default("Asia/Kolkata") @db.VarChar(50)
  currency        String    @default("INR") @db.VarChar(3)
  fiscalYearStart Int       @default(4)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  users           User[]
  resources       Resource[]
  projects        Project[]
  clients         Client[]
  contracts       Contract[]
  allocations     Allocation[]
  practices       Practice[]
  locations       Location[]
  skills          Skill[]
  skillCategories SkillCategory[]
  roles           Role[]
  auditLogs       AuditLog[]
  timesheetEntries TimesheetEntry[]
  timesheetPeriods TimesheetPeriod[]
  opportunities    Opportunity[]
  currencies       Currency[]
  documents        Document[]

  @@index([status])
  @@index([tier])
}

enum TenantTier {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// =============================================================================
// USER (System User)
// =============================================================================
model User {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  resourceId      String?   @db.Uuid
  resource        Resource? @relation(fields: [resourceId], references: [id])
  email           String    @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  status          UserStatus @default(ACTIVE)
  emailVerified   Boolean   @default(false)
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?   @db.VarChar(100)
  microsoftId     String?   @db.VarChar(100)  // Azure AD Object ID for SSO
  googleId        String?   @db.VarChar(100)  // Google ID for future SSO
  preferences     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  roles               UserRole[]
  allocationsRequested Allocation[] @relation("AllocationRequestedBy")
  allocationsApproved  Allocation[] @relation("AllocationApprovedBy")
  timesheetsApproved   TimesheetEntry[] @relation("TimesheetApprovedBy")
  periodsApproved      TimesheetPeriod[] @relation("PeriodApprovedBy")
  skillsVerified       ResourceSkill[] @relation("SkillVerifiedBy")
  auditLogs            AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// =============================================================================
// ROLE & PERMISSIONS
// =============================================================================
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false)
  permissions Json      // Legacy: Array of permission strings
  level       Int       @default(0)  // Hierarchy level: 0=org, 1=delivery, 2=practice, 3=team
  parentRoleId String?  @db.Uuid
  parentRole   Role?    @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  users           UserRole[]
  childRoles      Role[] @relation("RoleHierarchy")
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
}

model UserRole {
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  roleId      String   @db.Uuid
  role        Role     @relation(fields: [roleId], references: [id])
  assignedAt  DateTime @default(now())
  assignedBy  String   @db.Uuid

  @@id([userId, roleId])
}

// =============================================================================
// RESOURCE (Employee/Contractor)
// =============================================================================
model Resource {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  practiceId      String?   @db.Uuid
  practice        Practice? @relation(fields: [practiceId], references: [id])
  managerId       String?   @db.Uuid
  manager         Resource? @relation("ResourceManager", fields: [managerId], references: [id])
  locationId      String?   @db.Uuid
  location        Location? @relation(fields: [locationId], references: [id])
  
  // Identity
  employeeId      String    @db.VarChar(50)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  preferredName   String?   @db.VarChar(100)
  email           String    @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  photoUrl        String?   @db.VarChar(500)
  
  // Employment
  employmentType  EmploymentType
  band            String    @db.VarChar(10)
  designation     String    @db.VarChar(100)
  department      String?   @db.VarChar(100)
  dateOfJoining   DateTime  @db.Date
  dateOfExit      DateTime? @db.Date
  exitReason      String?   @db.VarChar(200)
  
  // Capacity
  capacity        Int       @default(100)
  costPerHour     Decimal?  @db.Decimal(10, 2)
  billRateDefault Decimal?  @db.Decimal(10, 2)
  
  // Status
  status          ResourceStatus @default(ACTIVE)
  benchSince      DateTime? @db.Date
  lastAllocatedAt DateTime? @db.Date
  
  // Metadata
  tags            String[]
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  user              User[]
  directReports     Resource[] @relation("ResourceManager")
  skills            ResourceSkill[]
  allocations       Allocation[]
  projectsManaged   Project[] @relation("ProjectManager")
  contractsManaged  Contract[] @relation("ContractAccountManager")
  opportunitiesOwned Opportunity[] @relation("OpportunityOwner")
  timesheetEntries  TimesheetEntry[]
  timesheetPeriods  TimesheetPeriod[]
  practicesHead     Practice[] @relation("PracticeHead")

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, practiceId])
  @@index([tenantId, band])
  @@index([tenantId, benchSince])
}

enum EmploymentType {
  FTE
  CONTRACTOR
  INTERN
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  NOTICE
}

// =============================================================================
// SKILL & RESOURCE_SKILL
// =============================================================================
model SkillCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(7)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skills    Skill[]

  @@unique([tenantId, name])
}

model Skill {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  categoryId   String?   @db.Uuid
  category     SkillCategory? @relation(fields: [categoryId], references: [id])
  name         String    @db.VarChar(100)
  description  String?   @db.VarChar(500)
  isVerifiable Boolean   @default(false)
  status       SkillStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  resources    ResourceSkill[]

  @@unique([tenantId, name])
}

enum SkillStatus {
  ACTIVE
  DEPRECATED
}

model ResourceSkill {
  resourceId   String   @db.Uuid
  resource     Resource @relation(fields: [resourceId], references: [id])
  skillId      String   @db.Uuid
  skill        Skill    @relation(fields: [skillId], references: [id])
  proficiency  Proficiency
  yearsExp     Decimal? @db.Decimal(3, 1)
  lastUsed     DateTime? @db.Date
  certified    Boolean  @default(false)
  certExpiry   DateTime? @db.Date
  verifiedBy   String?  @db.Uuid
  verifiedByUser User?  @relation("SkillVerifiedBy", fields: [verifiedBy], references: [id])
  verifiedAt   DateTime?
  notes        String?  @db.VarChar(500)
  updatedAt    DateTime @updatedAt

  @@id([resourceId, skillId])
  @@index([skillId])
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// =============================================================================
// CLIENT
// =============================================================================
model Client {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String    @db.VarChar(200)
  code           String    @db.VarChar(20)
  industry       String?   @db.VarChar(100)
  website        String?   @db.VarChar(255)
  logoUrl        String?   @db.VarChar(500)
  status         ClientStatus @default(ACTIVE)
  tier           ClientTier?
  billingAddress Json?
  contacts       Json?
  notes          String?
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  contracts      Contract[]
  projects       Project[]
  opportunities  Opportunity[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, tier])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum ClientTier {
  STRATEGIC
  KEY
  STANDARD
}

// =============================================================================
// CONTRACT
// =============================================================================
model Contract {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  clientId        String    @db.Uuid
  client          Client    @relation(fields: [clientId], references: [id])
  accountMgrId    String?   @db.Uuid
  accountManager  Resource? @relation("ContractAccountManager", fields: [accountMgrId], references: [id])
  
  // Identity
  contractNumber  String    @db.VarChar(50)
  name            String    @db.VarChar(200)
  type            ContractType
  description     String?
  
  // Timeline
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  signedDate      DateTime? @db.Date
  
  // Financials
  value           Decimal?  @db.Decimal(15, 2)
  currency        String    @default("INR") @db.VarChar(3)
  billingType     BillingType
  paymentTerms    String?   @db.VarChar(50)
  
  // Status
  status          ContractStatus @default(DRAFT)
  renewalDate     DateTime? @db.Date
  autoRenew       Boolean   @default(false)
  
  // Documents
  documentUrl     String?   @db.VarChar(500)
  attachments     Json?
  
  // Metadata
  notes           String?
  customFields    Json?
  externalRefs    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  projects        Project[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@index([tenantId, renewalDate])
}

enum ContractType {
  MSA
  SOW
  AMENDMENT
  NDA
  OTHER
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum BillingType {
  TM
  FIXED
  RETAINER
  MILESTONE
  HYBRID
}

// =============================================================================
// PROJECT
// =============================================================================
model Project {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  clientId        String?   @db.Uuid
  client          Client?   @relation(fields: [clientId], references: [id])
  contractId      String?   @db.Uuid
  contract        Contract? @relation(fields: [contractId], references: [id])
  managerId       String?   @db.Uuid
  manager         Resource? @relation("ProjectManager", fields: [managerId], references: [id])
  practiceId      String?   @db.Uuid
  practice        Practice? @relation(fields: [practiceId], references: [id])
  
  // Identity
  code            String    @db.VarChar(50)
  name            String    @db.VarChar(200)
  description     String?
  
  // Classification
  type            ProjectType
  category        String?   @db.VarChar(100)
  deliveryModel   DeliveryModel?
  
  // Timeline
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  actualEndDate   DateTime? @db.Date
  
  // Financials
  budgetHours     Int?
  budgetAmount    Decimal?  @db.Decimal(15, 2)
  billingType     BillingType?
  defaultRate     Decimal?  @db.Decimal(10, 2)
  
  // Status
  status          ProjectStatus @default(PIPELINE)
  healthStatus    HealthStatus?
  priority        Priority    @default(MEDIUM)
  
  // Metadata
  tags            String[]
  customFields    Json?
  externalRefs    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  allocations     Allocation[]
  timesheetEntries TimesheetEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, type])
  @@index([tenantId, startDate, endDate])
}

enum ProjectType {
  BILLABLE
  INTERNAL
  PRESALES
  SUPPORT
}

enum ProjectStatus {
  PIPELINE
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum DeliveryModel {
  ONSITE
  OFFSHORE
  HYBRID
}

enum HealthStatus {
  GREEN
  AMBER
  RED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =============================================================================
// ALLOCATION
// =============================================================================
model Allocation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  resourceId      String    @db.Uuid
  resource        Resource  @relation(fields: [resourceId], references: [id])
  projectId       String    @db.Uuid
  project         Project   @relation(fields: [projectId], references: [id])
  requestedById   String?   @db.Uuid
  requestedBy     User?     @relation("AllocationRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?   @db.Uuid
  approvedBy      User?     @relation("AllocationApprovedBy", fields: [approvedById], references: [id])
  
  // Assignment
  role            String    @db.VarChar(100)
  percentage      Int
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  actualEndDate   DateTime? @db.Date
  
  // Status
  status          AllocationStatus @default(PROPOSED)
  isBillable      Boolean   @default(true)
  billRate        Decimal?  @db.Decimal(10, 2)
  
  // Lifecycle
  confirmedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?   @db.VarChar(500)
  
  // Metadata
  notes           String?
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  timesheetEntries TimesheetEntry[]

  @@index([tenantId, resourceId, startDate, endDate])
  @@index([tenantId, projectId, startDate, endDate])
  @@index([tenantId, status])
  @@index([tenantId, endDate])
}

enum AllocationStatus {
  PROPOSED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

// =============================================================================
// PRACTICE (Business Unit)
// =============================================================================
model Practice {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  headId            String?   @db.Uuid
  head              Resource? @relation("PracticeHead", fields: [headId], references: [id])
  parentId          String?   @db.Uuid
  parent            Practice? @relation("PracticeHierarchy", fields: [parentId], references: [id])
  name              String    @db.VarChar(100)
  code              String    @db.VarChar(20)
  description       String?   @db.VarChar(500)
  targetUtilization Int?
  costCenter        String?   @db.VarChar(50)
  status            PracticeStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  children          Practice[] @relation("PracticeHierarchy")
  resources         Resource[]
  projects          Project[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
}

enum PracticeStatus {
  ACTIVE
  INACTIVE
}

// =============================================================================
// LOCATION
// =============================================================================
model Location {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(20)
  type      LocationType
  address   Json?
  timezone  String    @db.VarChar(50)
  country   String    @db.VarChar(2)
  isOnshore Boolean   @default(false)
  status    LocationStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  resources Resource[]

  @@unique([tenantId, code])
}

enum LocationType {
  OFFICE
  REMOTE
  CLIENT_SITE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

// =============================================================================
// TIMESHEET_ENTRY
// =============================================================================
model TimesheetEntry {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  resourceId      String    @db.Uuid
  resource        Resource  @relation(fields: [resourceId], references: [id])
  projectId       String    @db.Uuid
  project         Project   @relation(fields: [projectId], references: [id])
  allocationId    String?   @db.Uuid
  allocation      Allocation? @relation(fields: [allocationId], references: [id])
  approvedById    String?   @db.Uuid
  approvedBy      User?     @relation("TimesheetApprovedBy", fields: [approvedById], references: [id])
  
  // Time Entry
  date            DateTime  @db.Date
  hours           Decimal   @db.Decimal(4, 2)
  taskType        String?   @db.VarChar(100)
  description     String?
  
  // Classification
  isBillable      Boolean   @default(true)
  isOvertime      Boolean   @default(false)
  billRate        Decimal?  @db.Decimal(10, 2)
  
  // Status
  status          TimesheetStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.VarChar(500)
  
  // Metadata
  tags            String[]
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([tenantId, resourceId, date])
  @@index([tenantId, projectId, date])
  @@index([tenantId, status, date])
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
}

// =============================================================================
// TIMESHEET_PERIOD
// =============================================================================
model TimesheetPeriod {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  resourceId      String    @db.Uuid
  resource        Resource  @relation(fields: [resourceId], references: [id])
  approvedById    String?   @db.Uuid
  approvedBy      User?     @relation("PeriodApprovedBy", fields: [approvedById], references: [id])
  
  // Period
  periodStart     DateTime  @db.Date
  periodEnd       DateTime  @db.Date
  periodType      PeriodType
  
  // Aggregates
  totalHours      Decimal   @db.Decimal(5, 2)
  billableHours   Decimal   @db.Decimal(5, 2)
  overtimeHours   Decimal   @db.Decimal(5, 2)
  
  // Status
  status          PeriodStatus @default(OPEN)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  comments        String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, resourceId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@index([tenantId, periodEnd])
}

enum PeriodType {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PeriodStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

// =============================================================================
// OPPORTUNITY (Pipeline/Deals from CRM)
// =============================================================================
model Opportunity {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  clientId           String?   @db.Uuid
  client             Client?   @relation(fields: [clientId], references: [id])
  ownerId            String?   @db.Uuid
  owner              Resource? @relation("OpportunityOwner", fields: [ownerId], references: [id])
  
  // Identity
  externalId         String    @db.VarChar(100)
  name               String    @db.VarChar(200)
  description        String?
  
  // Pipeline
  stage              String    @db.VarChar(50)
  probability        Int?
  expectedCloseDate  DateTime? @db.Date
  
  // Value
  dealValue          Decimal?  @db.Decimal(15, 2)
  currency           String    @default("INR") @db.VarChar(3)
  
  // Resource Needs
  estimatedHeadcount Int?
  requiredSkills     Json?
  estimatedStart     DateTime? @db.Date
  estimatedDuration  Int?
  
  // Status
  status             OpportunityStatus @default(OPEN)
  wonDate            DateTime? @db.Date
  lostDate           DateTime? @db.Date
  lostReason         String?   @db.VarChar(200)
  
  // Sync
  source             String    @db.VarChar(50)
  lastSyncedAt       DateTime?
  externalUrl        String?   @db.VarChar(500)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@unique([tenantId, externalId, source])
  @@index([tenantId, status])
  @@index([tenantId, stage])
  @@index([tenantId, expectedCloseDate])
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  STALLED
}

// =============================================================================
// AUDIT_LOG
// =============================================================================
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id])
  entityType  String    @db.VarChar(50)
  entityId    String    @db.Uuid
  action      AuditAction
  changes     Json?
  metadata    Json?
  timestamp   DateTime  @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, timestamp])
  @@index([tenantId, action])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  RENEW
  ACTIVATE
  TERMINATE
  LINK_CONTRACT
  UNLINK_CONTRACT
  APPROVE
  REJECT
  SUBMIT
}

// =============================================================================
// CURRENCY & EXCHANGE RATES
// =============================================================================
model Currency {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  code        String    @db.VarChar(3)   // ISO 4217: USD, INR, EUR
  name        String    @db.VarChar(100)
  symbol      String    @db.VarChar(10)
  isBase      Boolean   @default(false)  // Organization's base currency
  isActive    Boolean   @default(true)
  decimalPlaces Int     @default(2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")

  @@unique([tenantId, code])
  @@index([tenantId, isBase])
  @@index([tenantId, isActive])
}

model ExchangeRate {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  fromCurrencyId  String    @db.Uuid
  fromCurrency    Currency  @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrencyId    String    @db.Uuid
  toCurrency      Currency  @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  rate            Decimal   @db.Decimal(18, 8)  // High precision for currency conversion
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  source          String    @default("MANUAL") @db.VarChar(50)  // MANUAL, API, IMPORT
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, fromCurrencyId, toCurrencyId, effectiveFrom])
  @@index([tenantId, effectiveFrom])
  @@index([tenantId, fromCurrencyId, toCurrencyId])
}

// =============================================================================
// ENHANCED ROLE MANAGEMENT
// =============================================================================
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  module      String    @db.VarChar(50)   // resources, projects, contracts, etc.
  action      String    @db.VarChar(50)   // create, read, update, delete, approve, export
  scope       String    @default("ALL") @db.VarChar(50)  // ALL, OWN, TEAM, PRACTICE
  description String?   @db.VarChar(200)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@unique([tenantId, module, action, scope])
  @@index([tenantId, module])
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  conditions   Json?      // Additional conditions for fine-grained access
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model RoleAssignmentAudit {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  action      String    @db.VarChar(20)   // ASSIGNED, REVOKED
  assignedBy  String    @db.Uuid
  reason      String?   @db.VarChar(500)
  timestamp   DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, timestamp])
}

// =============================================================================
// DOCUMENT MANAGEMENT
// =============================================================================
model Document {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  
  // Identity
  name              String    @db.VarChar(255)
  description       String?
  mimeType          String    @db.VarChar(100)
  fileSize          Int       // Size in bytes
  
  // Classification
  classification    DocumentClassification @default(INTERNAL)
  category          String?   @db.VarChar(100)  // MSA, SOW, CR, INVOICE, TIMESHEET, etc.
  tags              String[]
  
  // Storage
  storageProvider   String    @default("LOCAL") @db.VarChar(50)  // LOCAL, S3, AZURE
  storagePath       String    @db.VarChar(500)
  checksum          String?   @db.VarChar(64)  // SHA-256 hash for integrity
  
  // Relationships
  entityType        String?   @db.VarChar(50)   // contract, project, resource, etc.
  entityId          String?   @db.Uuid
  
  // E-Signature
  signatureStatus   SignatureStatus?
  signatureProvider String?   @db.VarChar(50)  // DOCUSIGN, ADOBE_SIGN
  signatureRef      String?   @db.VarChar(200) // External signature ID
  
  // Current version tracking
  currentVersionId  String?   @db.Uuid
  versionCount      Int       @default(1)
  
  // Ownership
  uploadedById      String    @db.Uuid
  
  // Status
  status            DocumentStatus @default(ACTIVE)
  expiresAt         DateTime?
  
  // Metadata
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  versions          DocumentVersion[]
  accessRules       DocumentAccess[]
  accessLogs        DocumentAccessLog[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, classification])
  @@index([tenantId, category])
  @@index([tenantId, status])
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum SignatureStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
}

model DocumentVersion {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  
  // Storage
  storagePath   String    @db.VarChar(500)
  fileSize      Int
  checksum      String?   @db.VarChar(64)
  
  // Metadata
  changeNotes   String?   @db.VarChar(500)
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentAccess {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Access target (one of these should be set)
  roleId        String?   @db.Uuid
  userId        String?   @db.Uuid
  practiceId    String?   @db.Uuid
  
  // Permissions
  canView       Boolean   @default(true)
  canDownload   Boolean   @default(false)
  canEdit       Boolean   @default(false)
  canDelete     Boolean   @default(false)
  canShare      Boolean   @default(false)
  
  // Time-bound access
  expiresAt     DateTime?
  
  // Audit
  grantedById   String    @db.Uuid
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([documentId])
  @@index([roleId])
  @@index([userId])
}

model DocumentAccessLog {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String    @db.Uuid
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  action      String    @db.VarChar(50)  // VIEW, DOWNLOAD, EDIT, DELETE, SHARE
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(500)
  timestamp   DateTime  @default(now())

  @@index([documentId, timestamp])
  @@index([userId, timestamp])
}

// =============================================================================
// AI AGENT CONVERSATIONS
// =============================================================================
model AgentConversation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  title       String?   @db.VarChar(200)
  context     Json?     // Current context (page, selected entity, etc.)
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  messages    AgentMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, updatedAt])
}

model AgentMessage {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String    @db.VarChar(20)  // user, assistant, system
  content         String
  
  // AI Metadata
  model           String?   @db.VarChar(50)   // gemini-flash, gpt-4o-mini, etc.
  tokens          Json?     // { input: X, output: Y }
  confidence      Decimal?  @db.Decimal(3, 2)
  routingTier     String?   @db.VarChar(20)   // T1, T2, T3, T4
  
  // Response rendering
  responseType    String?   @db.VarChar(50)   // text, table, chart, cards
  responseData    Json?     // Structured data for rich rendering
  
  // Feedback
  feedback        String?   @db.VarChar(20)   // positive, negative
  feedbackNote    String?   @db.VarChar(500)
  
  timestamp       DateTime  @default(now())

  @@index([conversationId, timestamp])
}

// =============================================================================
// AI MIGRATION TOOL
// =============================================================================
model ImportJob {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  
  // Job Identity
  name            String    @db.VarChar(200)
  description     String?
  
  // Source File
  sourceFileName  String    @db.VarChar(255)
  sourceFileType  String    @db.VarChar(50)   // CSV, XLSX, JSON, PDF, IMAGE
  sourceFileSize  Int
  sourceFilePath  String    @db.VarChar(500)
  
  // Import Configuration
  importPurpose   ImportPurpose @default(MIGRATION)
  duplicateAction DuplicateAction @default(SKIP)
  
  // AI Analysis
  detectedEntities Json?    // { resources: 500, allocations: 200, ... }
  fieldMappings   Json?     // AI-suggested mappings
  dependencyOrder Json?     // Order to import entities
  referencesToCreate Json?  // Missing references to auto-create
  
  // Autonomy Level (earned over time)
  autonomyLevel   Int       @default(1)  // 1=confirm all, 2=auto high-confidence, 3=full auto
  sourceFingerprint String? @db.VarChar(64)  // Hash to identify same source format
  
  // Processing Status
  status          ImportJobStatus @default(PENDING_ANALYSIS)
  analysisStarted DateTime?
  analysisCompleted DateTime?
  importStarted   DateTime?
  importCompleted DateTime?
  
  // Results
  totalRecords    Int       @default(0)
  importedRecords Int       @default(0)
  skippedRecords  Int       @default(0)
  errorRecords    Int       @default(0)
  
  // Auto-created references
  autoCreatedRefs Json?     // { practices: ['AI & ML'], locations: ['Coimbatore'] }
  
  // Rollback
  canRollback     Boolean   @default(true)
  rollbackExpires DateTime?
  rolledBackAt    DateTime?
  rolledBackBy    String?   @db.Uuid
  
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  records         ImportJobRecord[]
  mappings        ImportMapping[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, sourceFingerprint])
}

enum ImportPurpose {
  MIGRATION       // First-time bulk load - skip duplicates
  SYNC            // Refresh from HR system - update duplicates
  MANUAL          // Ad-hoc upload - flag duplicates
}

enum DuplicateAction {
  SKIP            // Keep existing, ignore incoming
  UPDATE          // Overwrite existing with incoming
  FLAG            // Mark for user review
}

enum ImportJobStatus {
  PENDING_ANALYSIS    // File uploaded, waiting for AI analysis
  ANALYZING           // AI analyzing file
  PENDING_APPROVAL    // Waiting for user to approve mappings/refs
  APPROVED            // User approved, ready to import
  IMPORTING           // Import in progress
  COMPLETED           // Import finished
  COMPLETED_WITH_ERRORS // Import finished with some errors
  FAILED              // Import failed
  ROLLED_BACK         // Import was rolled back
}

model ImportMapping {
  id              String    @id @default(uuid()) @db.Uuid
  importJobId     String    @db.Uuid
  importJob       ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  
  // Source Column
  sourceColumn    String    @db.VarChar(100)
  sourceSampleValues Json?  // First few values for preview
  
  // Target Field
  targetEntity    String    @db.VarChar(50)   // resource, project, allocation, etc.
  targetField     String    @db.VarChar(100)
  
  // AI Confidence
  confidence      Decimal   @db.Decimal(3, 2) // 0.00 to 1.00
  aiReasoning     String?   @db.VarChar(500)  // Why AI made this mapping
  
  // User Override
  userApproved    Boolean   @default(false)
  userOverridden  Boolean   @default(false)
  
  // Transformation
  transformationType String? @db.VarChar(50)  // DATE_PARSE, LOOKUP, UPPERCASE, etc.
  transformationConfig Json? // Config for transformation
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([importJobId, sourceColumn])
  @@index([importJobId])
}

model ImportJobRecord {
  id              String    @id @default(uuid()) @db.Uuid
  importJobId     String    @db.Uuid
  importJob       ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  
  // Source Data
  rowNumber       Int
  sourceData      Json      // Original row data
  
  // Target
  targetEntity    String    @db.VarChar(50)
  targetId        String?   @db.Uuid  // ID of created/updated record
  
  // Processing
  status          ImportRecordStatus @default(PENDING)
  confidence      Decimal?  @db.Decimal(3, 2)
  
  // Errors/Warnings
  errors          Json?     // Array of error messages
  warnings        Json?     // Array of warning messages
  
  // For rollback
  previousData    Json?     // Data before update (for rollback)
  wasCreated      Boolean   @default(false) // true if new record, false if update
  
  createdAt       DateTime  @default(now())

  @@index([importJobId, status])
  @@index([importJobId, targetEntity])
}

enum ImportRecordStatus {
  PENDING         // Waiting to be processed
  PROCESSING      // Currently being processed
  IMPORTED        // Successfully imported
  UPDATED         // Successfully updated existing
  SKIPPED         // Skipped (duplicate, etc.)
  ERROR           // Failed with error
  FLAGGED         // Flagged for user review
}


