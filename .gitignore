# RMGaaS - Ignore Patterns

# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/

# Environment files (contain secrets)
.env
.env.local
.env.*.local
.env.staging
.env.production

# IDE
.idea/
*.swp
*.swo
.vscode/settings.json
.vscode/launch.json

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Testing
coverage/

# Temporary
tmp/
temp/
*.tmp

# Session tracking (contains runtime data)
.context/sessions/.current_session

# Prisma
prisma/*.db
prisma/*.db-journal
